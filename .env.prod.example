# ==============================================================================
# Shoppin Production Environment Configuration (.env.prod)
# Copy to .env.prod on your EC2 / Lightsail instance: cp .env.prod.example .env.prod
# DO NOT COMMIT .env.prod TO SOURCE CONTROL!
# ==============================================================================

# Domain Configuration (Used by Caddy for automatic Let's Encrypt SSL and CSRF origins)
DOMAIN_NAME=shoppin.yourdomain.com

# Django Core Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here

# PostgreSQL Database Credentials (Internal to Docker network)
POSTGRES_DB=shoppin_db
POSTGRES_USER=shoppin_user
POSTGRES_PASSWORD=generate-a-strong-database-password-here

# Kroger Developer API Credentials (for supermarket aisle lookups)
# Obtain from https://developer.kroger.com/
KROGER_CLIENT_ID=your-kroger-client-id
KROGER_CLIENT_SECRET=your-kroger-client-secret

# Google OAuth 2.0 Credentials (Optional, for Google Sign-In)
# Obtain from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3 Backup Destination (Used by scripts/backup-db.sh)
S3_BACKUP_BUCKET=your-unique-s3-backup-bucket-name
AWS_DEFAULT_REGION=us-east-1
