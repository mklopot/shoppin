# ==============================================================================
# Shoppin Production Caddyfile
# Automatic Let's Encrypt TLS, HTTP/2 & HTTP/3, Static Files, & Daphne WebSockets
# ==============================================================================

{$DOMAIN_NAME:localhost} {
    # Automatic HTTPS: Let's Encrypt / ZeroSSL certificate provisioning and auto-renewal
    # For production, define DOMAIN_NAME in .env.prod (e.g. DOMAIN_NAME=shoppin.app)
    # If DOMAIN_NAME is localhost, Caddy provisions a local self-signed certificate.

    # Compression
    encode gzip zstd

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Serve collected static files directly from shared volume
    handle /static/* {
        root * /var/www
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Serve uploaded user recipe media files directly from shared volume
    handle /media/* {
        root * /var/www
        file_server
        header Cache-Control "public, max-age=86400"
    }

    # Health check passthrough (quick retry so health monitors detect recovery promptly)
    handle /health/ {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            lb_try_duration 2s
            lb_try_interval 200ms
        }
    }

    # Reverse proxy all dynamic HTTP traffic and /ws/* WebSockets to Daphne
    handle {
        reverse_proxy web:8000 {
            # Daphne runs on port 8000 inside the Docker network
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Seamless reload: Hold in-flight requests for up to 10s while Daphne restarts
            lb_try_duration 10s
            lb_try_interval 250ms
            fail_duration 1s

            # Extended buffer and timeout settings for long-lived WebSocket sessions
            transport http {
                read_buffer 4096
            }
        }
    }

    # Automatic maintenance placeholder page when backend is restarting or unavailable
    handle_errors 502 503 {
        header Retry-After "3"
        header Cache-Control "no-store, no-cache, must-revalidate"
        root * /var/www/static
        rewrite * /maintenance.html
        file_server
    }
}
