# ==============================================================================
# Shoppin Lightsail Production Environment Template (.env)
# Copy to /app/.env on your Lightsail instance: cp deploy/lightsail/.env.lightsail.example /app/.env
# ==============================================================================

# Your public domain name (e.g. shoppin.app or grocery.mydomain.com)
DOMAIN_NAME=shoppin.yourdomain.com

# Django Core Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=shoppin.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://shoppin.yourdomain.com

# ------------------------------------------------------------------------------
# DATABASE & CHANNEL LAYER NOTE FOR $5 LIGHTSAIL:
# Leave DATABASE_URL and REDIS_URL UNSET / EMPTY!
# Shoppin will automatically use:
# 1. SQLite in WAL mode (concurrent, rock-solid, zero RAM overhead)
# 2. InMemoryChannelLayer (sub-millisecond WebSocket sync in Daphne memory)
# ------------------------------------------------------------------------------
# DATABASE_URL=
# REDIS_URL=

# Supermarket Aisle Lookups (Kroger Developer API)
# Obtain from https://developer.kroger.com/
KROGER_CLIENT_ID=your-kroger-client-id
KROGER_CLIENT_SECRET=your-kroger-client-secret

# Optional Google OAuth Single Sign-On
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://shoppin.yourdomain.com/accounts/google/callback/
DEV_AUTO_LOGIN=False

# Optional Offsite S3 Backup Destination
S3_BACKUP_BUCKET=your-unique-s3-backup-bucket-name
AWS_DEFAULT_REGION=us-east-1
