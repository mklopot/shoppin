# ==============================================================================
# Shoppin Lightsail Production Environment Template (.env)
# Copy to /app/.env on your Lightsail instance: cp deploy/lightsail/.env.lightsail.example /app/.env
# ==============================================================================

# Your public domain name (e.g. shoppin.app or grocery.mydomain.com)
DOMAIN_NAME=shoppin.yourdomain.com

# Django Core Security
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=shoppin.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://shoppin.yourdomain.com

# ------------------------------------------------------------------------------
# DATABASE & CHANNEL LAYER NOTE FOR $5 LIGHTSAIL:
# Leave DATABASE_URL and REDIS_URL UNSET / EMPTY!
# Shoppin will automatically use:
# 1. SQLite in WAL mode (concurrent, rock-solid, zero RAM overhead)
# 2. InMemoryChannelLayer (sub-millisecond WebSocket sync in Daphne memory)
# ------------------------------------------------------------------------------
# DATABASE_URL=
# REDIS_URL=

# Supermarket Aisle Lookups (Kroger Developer API)
# Obtain from https://developer.kroger.com/
KROGER_CLIENT_ID=your-kroger-client-id
KROGER_CLIENT_SECRET=your-kroger-client-secret

# Optional Google OAuth Single Sign-On
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://shoppin.yourdomain.com/accounts/google/callback/
DEV_AUTO_LOGIN=False

# Automated Offsite Amazon S3 Backups (Used by backup-sqlite.sh)
# Create a dedicated IAM user with AmazonS3FullAccess or s3:PutObject on this bucket:
S3_BACKUP_BUCKET=your-unique-s3-backup-bucket-name
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-access-key-secret

# Automated Image Moderation (Amazon Rekognition DetectModerationLabels)
# Uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION above.
# Ensure the IAM user has the `rekognition:DetectModerationLabels` permission!
# Enabled automatically when DJANGO_DEBUG=False.
# AWS_REKOGNITION_REGION=us-east-1
# IMAGE_MODERATION_ENABLED=True
# IMAGE_MODERATION_MIN_CONFIDENCE=60.0
# IMAGE_MODERATION_BLOCK_ALCOHOL=False

# Recipe Photo OCR / Handwriting Recognition (Amazon Bedrock Converse API)
# Uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION above.
# Ensure the IAM user has `bedrock:InvokeModel` permission on the configured model / inference profile!
# AWS_BEDROCK_REGION=us-east-2
# AWS_BEDROCK_RECIPE_OCR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_BEDROCK_RECIPE_OCR_FALLBACK_MODEL_ID=us.amazon.nova-pro-v1:0
# RECIPE_PHOTO_OCR_MAX_PAGES=4
