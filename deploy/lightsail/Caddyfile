# ==============================================================================
# Shoppin Lightsail Caddyfile ($5/month Ultra-Low-Cost Deployment)
# Native Let's Encrypt SSL, Static/Media Delivery, & Daphne WebSockets
# ==============================================================================

{$DOMAIN_NAME:localhost} {
    # Automatic TLS certificate provisioning and renewal via Let's Encrypt
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Serve root icons and assets directly from local staticfiles
    @root_assets path /favicon.ico /apple-touch-icon.png /site.webmanifest /robots.txt /maintenance.html
    handle @root_assets {
        root * /app/staticfiles
        file_server
        header Cache-Control "public, max-age=86400, must-revalidate"
    }

    # Serve collected static files directly from local disk
    handle_path /static/* {
        root * /app/staticfiles
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Serve user recipe photos directly from local disk
    handle_path /media/* {
        root * /app/media
        file_server
        header Cache-Control "public, max-age=3600, must-revalidate"
    }

    # Health check passthrough (quick retry so health checks detect recovery promptly)
    handle /health* {
        reverse_proxy 127.0.0.1:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            lb_try_duration 1s
            lb_try_interval 200ms
            transport http {
                dial_timeout 500ms
            }
        }
    }

    # Reverse proxy dynamic requests and /ws/* WebSockets to Daphne ASGI server
    handle {
        reverse_proxy 127.0.0.1:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}

            # Seamless zero-downtime reload: Hold in-flight requests and retry for up to 20s while Daphne restarts
            # Note: Never set fail_duration with a single upstream; omitting it ensures Caddy retries every
            # 250ms instead of blacklisting the only upstream and aborting immediately with 502!
            lb_try_duration 20s
            lb_try_interval 250ms

            # Fast dial timeout & extended buffer for WebSockets
            transport http {
                dial_timeout 1s
                read_buffer 4096
            }
        }
    }

    # Automatic maintenance placeholder page when backend is restarting or unavailable
    handle_errors 5xx {
        header Retry-After "3"
        header Cache-Control "no-store, no-cache, must-revalidate"
        rewrite * /maintenance.html
        file_server {
            root /app/staticfiles
            status 503
        }
    }
}
